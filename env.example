# Confluence Configuration
# Copy this file to .env and fill in your values

# Your Confluence instance URL
# For Cloud: https://your-domain.atlassian.net
# For Server: https://confluence.your-domain.com
CONFLUENCE_URL=https://your-domain.atlassian.net

# Your Confluence email/username
CONFLUENCE_EMAIL=your-email@example.com

# Your Confluence API token
# Get one from: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-api-token-here

# --- Optional: Semantic search (RAG) ---
# Both have working defaults below; only set these to override them.

# fastembed model used to embed chunks and queries (downloaded locally on first use,
# no external API key required)
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where the local vector index is persisted. Relative paths resolve from the repo root.
# RAG_INDEX_DIR=data/rag_index




